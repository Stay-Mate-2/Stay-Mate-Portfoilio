# ------------------------------------------------------------------
# StayMate website — environment variables (copy to .env.local)
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ------------------------------------------------------------------

# ---- Public site configuration (safe to expose) ------------------
# Production URL, e.g. https://staymate.example  (no trailing slash).
# Leave empty until the production domain is final: canonical URLs,
# Open Graph absolute URLs and the sitemap are enabled only when set.
NEXT_PUBLIC_SITE_URL=

# Set to "true" ONLY when the waitlist backend below is deployed and tested.
# While not "true" the early-access form is shown as "not open yet" and the
# submit button is disabled (no fake success is ever displayed).
NEXT_PUBLIC_WAITLIST_ENABLED=false

# Optional footer details. Rendered ONLY when provided (never invented).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ---- Server-only secrets (do NOT prefix with NEXT_PUBLIC_) -------
# Base URL of the StayMate backend, e.g. https://api.staymate.example
# (HTTPS in production). The website server forwards registrations to
# POST {WAITLIST_API_URL}/v1/waitlist
WAITLIST_API_URL=

# Shared secret that must equal WAITLIST_INGEST_KEY in the backend env.
# Generate with:  openssl rand -hex 32
WAITLIST_INGEST_KEY=
