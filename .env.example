# ------------------------------------------------------------------
# StayMate website — environment variables (copy to .env.local)
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ------------------------------------------------------------------

# ---- Public site configuration (safe to expose) ------------------
# Production URL, e.g. https://stay-mate-portfoilio.vercel.app (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Optional footer details. Rendered ONLY when provided (never invented).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ---- Server-only Early Access configuration (NEVER prefix NEXT_PUBLIC_) ----
# Server-controlled launch feature flag. Must remain "false" until deployed and verified.
EARLY_ACCESS_ENABLED=false

# Deployed Google Apps Script Web App (/exec) URL for StayMate_Early_Access_Database.
# Must be https://script.google.com/macros/s/.../exec in production.
STAYMATE_APPS_SCRIPT_URL=

# Cryptographically random shared secret (>= 32 bytes / 256 bits).
# Generate with: openssl rand -hex 32
# Must match SHARED_SECRET in Apps Script Project Properties verbatim.
STAYMATE_HMAC_SECRET=

# Exact allowed browser origin(s) for CSRF/Origin verification (comma-separated, no trailing slash).
# Example: https://stay-mate-portfoilio.vercel.app
STAYMATE_ALLOWED_ORIGIN=

# Upstash Redis REST credentials for fail-closed distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
