# ------------------------------------------------------------------
# StayMate website — public configuration (optional .env.local overrides)
# Zero server secrets or databases are required.
# ------------------------------------------------------------------

# Production URL, e.g. https://stay-mate-portfoilio.vercel.app (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Embedded Google Form responder URL (https://docs.google.com/forms/d/e/.../viewform).
# Embedded directly inside the #early-access card via ?embedded=true.
NEXT_PUBLIC_GOOGLE_FORM_URL=

# Public contact/privacy support email (defaults to staymate2@gmail.com when empty).
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional footer social links. Omitted automatically when empty.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_YOUTUBE_URL=
